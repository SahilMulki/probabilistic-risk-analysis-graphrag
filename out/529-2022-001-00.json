  "cause": {
    "proximate_text": "Inadequate engineering rigor in developing the modification engineering documents for implementation and testing allowed the new CT wiring to be landed on a terminal connection that was already in use and failed to identify the additional ground during the design validation testing, resulting in a grounded shield wire at the start-up transformer NAN-X01 W cabinet for the NAN-S06E cubicle differential relay CT from an unrelated billing and metering CT landed at a common terminal board location.",
    "cause_code": "B",
    "category": "Design/Manufacturing/Installation",
    "theme": "Modification engineering/design-validation deficiency (mis-wired CT ground)",
    "provisional": false
  },
