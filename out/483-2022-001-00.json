  "cause": {
    "proximate_text": "The cause of the reactor trip has been determined to be inadequate Operations surveillance procedure guidance regarding verifying re-energization of relay contacts. As appropriate criteria to verify a relay was de-energized existed, but adequate guidance to verify re-energization did not exist, Operations continued the test procedure believing the General Warning signal was no longer present when in fact a set of contacts internal to SSPS 'B' train Master Relay SB032CK524 failed to close/re-energize.",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "inadequate surveillance procedure verification guidance leading to relay contact failure to reset going undetected",
    "provisional": true
  },
