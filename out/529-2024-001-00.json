  "cause": {
    "proximate_text": "The direct cause was a line-to-ground fault on the B phase bushing in the B Train Class 1E 4.16kv switchgear causing an opening of the supply breaker to the ESF transformer, resulting in a loss of power to the B Train Class 1E 4.16kv bus. The apparent cause was water intrusion into the B Train 4.16kV Switchgear cubicle as a result of multiple cracks on the B phase bushing's mounting flange.",
    "cause_code": "C",
    "category": "External Cause",
    "theme": "water intrusion / bushing cracking",
    "provisional": false
  },
