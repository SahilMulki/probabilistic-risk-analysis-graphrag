  "cause": {
    "proximate_text": "Failure analysis performed jointly between FPL Engineering and Westinghouse revealed that the most likely cause of the incorrect RTB position logic was failure of the cell switch contact. Graphite grease used for lubrication was found accumulated and hardened, creating an electrical tracking path for the incorrect logic signal. A review of the FPL preventive maintenance procedure showed that steps to clean and reapply grease on the switch contacts is condition-based rather than prescriptive.",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "hardened lubricant causing electrical tracking on breaker cell switch; condition-based (not prescriptive) PM procedure",
    "provisional": true
  },
