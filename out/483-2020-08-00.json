  "cause": {
    "proximate_text": "The cause of the generator fault was due to failure of the connection rings on the main generator stator. Both the collector end connection ring (i.e., phase ring) and the turbine end connection ring (i.e., serial ring) failed, resulting in an electrical path from the generator stator to ground... The underlying cause of the connection ring failure is still under investigation and will be determined during the course of the generator disassembly and repair.",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "main generator stator connection ring failure - root cause under investigation",
    "provisional": true
  },
