  "cause": {
    "proximate_text": "The cause of this event was inadequate procedural guidance. Specifically, procedure 3-IDSB-SOP-001, \"Class 1E DC System-Division B,\" included instructions within the same attachment for both the 24 hour and 72 hour battery subsystems and resulted in operation of an unintended component.",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "procedure did not adequately separate 24-hour and 72-hour battery restoration steps, leading to operation of unintended component",
    "provisional": true
  },
