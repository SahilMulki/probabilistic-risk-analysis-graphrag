  "block_13": [],
  "cause": {
    "proximate_text": "Root Cause 1: STP's calibration procedure 0PMP05ZE0045 did not include instructions for adjusting the 21/G1 relay contacts per vendor technical document VTD-B455-0076; Root Cause 2: the Main Generator protection scheme was not fully updated to prevent the trip function of the 21/G1 relay when the Main Generator is offline and the MGCB is open; Contributing Cause: closing the door to Unit 2 CP010 caused a second vibration of relay 21/G1 and its actuation. Separately, PORV 2C was inoperable due to rough spots in the push button sleeve causing sticking, plus a known potentiometer defect; Load Center E2A1 breaker failed to close most likely due to dirty, high-resistance Control Room handswitch contacts.",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "Design/procedure deficiency in relay protection scheme plus independent component degradation (PORV sleeve/potentiometer, breaker handswitch contacts)",
    "provisional": true
  },
