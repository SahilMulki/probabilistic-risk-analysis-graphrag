    "title": "Supplement to Automatic Reactor Trip and Actuation of Two of Three Emergency Diesel Generators"
  },
  "reporting_basis": {
    "reported_under": [
      "10 CFR 50.73(a)(2)(iv)(A)",
      "10 CFR 50.73(a)(2)(iv)(B)(1)",
