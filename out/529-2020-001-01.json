  "cause": {
    "proximate_text": "The cause of the event was attributed to a lack of guidance in the operating procedures related to the impact of de-energization and re-energization of the MFWP A and B LO control panels. The cause was also attributed to the lack of a redundant power source to prevent both MFWPs from tripping simultaneously which led to the Unit trip.",
    "cause_code": "X",
    "category": "Other",
    "theme": "Inadequate procedural guidance and lack of redundant power source for MFWP lube oil control panels",
    "provisional": false
  },
