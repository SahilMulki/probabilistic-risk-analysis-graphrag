  "cause": {
    "proximate_text": "The root cause of the event was determined to be that Operations leadership did not ensure the Operators were prepared to respond to a loss of cooling event on the main transformers to minimize the potential for a required manual scram. This included not ensuring that procedures, training, and readiness were aligned to restore cooling in a total loss of cooling event and to protect the in-service cooling group in a partial loss of cooling event",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "Operations leadership / communication and training program deficiency",
    "provisional": true
  },
