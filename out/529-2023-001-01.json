  "cause": {
    "proximate_text": "The direct cause of the reactor trip was determined to be the result of the loose nuts on either side of the moveable armature block within the servo control valve installed in the \"A\" FWCS. The root cause of the loose nuts within the servo control valve was determined to be that station guidance did not exist which would direct station personnel who receive, test, and install the servo control valves to inspect for loose or insufficiently tightened nuts.",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "Missing inspection guidance for servo valve receipt/installation",
    "provisional": true
  },
