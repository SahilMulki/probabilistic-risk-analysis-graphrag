  "cause": {
    "proximate_text": "the vendor incorrectly calculated the engineering conversion factor for ARMIRE5400B during plant construction, and inadequate procedural guidance for vendor oversight was attributed to ARMIRE5400B not having the correct engineering conversion factor installed; the calibration procedure for the containment high range radiation monitors did not require an update to the engineering conversion factor for a new detector, and the main steam line calibration procedure did not include steps to record new ion chamber output dose rate reference values",
    "cause_code": "D",
    "category": "Defective Procedure",
    "theme": "Calibration procedures failed to account for conversion factor/keep-alive source and reference value updates",
    "provisional": false
  },
