  "cause": {
    "proximate_text": "This event was initiated in the test circuitry by the loss of hold power circuit continuity for critical ESF trip paths through the PPS Relay Hold Switch and Terminal Block (TB701). This momentarily removed the \"hold\" voltage to the matrix relay test coils that prevent transfer of the matrix relay contacts in the SIAS, CIAS, and MSIS Initiation Logic circuits, which allowed the trip signals to initiate the applicable plant response.",
    "cause_code": "X",
    "category": "Other",
    "theme": "test-circuit relay hold power loss causing invalid ESFAS actuation",
    "provisional": false
  },
