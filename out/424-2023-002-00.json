  "cause": {
    "proximate_text": "Heater Drain pump 'B' failed due to a surge experienced by the motor, causing a phase-to-phase fault. Condensate pump 'A' failed to start due to the differential relay being in the tripped position, causing the lockout relay to trip and preventing breaker closure; subsequent troubleshooting could not determine the cause of the differential relay being tripped prior to the pump start demand.",
    "cause_code": "X",
    "category": "Other",
    "theme": "Unresolved dual equipment failure (motor fault + relay malfunction of undetermined cause)",
    "provisional": false
  },
