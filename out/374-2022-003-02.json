  "cause": {
    "proximate_text": "The cause of the isophase bus duct (IPBD) fire was incorrect joint compound having been supplied and subsequently used during the planned maintenance performed during the previous Unit 2 refueling outage in 2021. This resulted in high shunt bolted connection resistance causing overheating in the bolted connections. The overheating resulted in a failure of the IPBD support structure hardware and ignition of the retractable cover neoprene gasket.",
    "cause_code": "X",
    "category": "Other",
    "theme": "incorrect joint compound causing bolted connection overheating",
    "provisional": false
  },
