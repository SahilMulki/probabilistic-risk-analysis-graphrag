  "cause": {
    "proximate_text": "The cause of the failure was unclear vendor guidance and insufficient procedural guidance regarding orientation for the installation of the internal plunger well plastic guides. The internal plunger well plastic guides were found to be incorrectly installed in the 2-0203-3B ERV actuator, which caused actuator binding. Contributing to the failure was that the upper guide bracket did not have proper straightness and was found warped.",
    "cause_code": "D",
    "category": "Defective Procedure",
    "theme": "Unclear vendor/procedural guidance on plunger well guide orientation during actuator rebuild",
    "provisional": false
  },
