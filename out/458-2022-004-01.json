  "cause": {
    "proximate_text": "the root cause for the HPCS Transformer failure was a cable to bus bar connection design that was susceptible to degradation from routine maintenance...The configuration did not provide a provision for installing a backing wrench to prevent the threaded studs from rotating when the connection nuts are being loosened or tightened. Torsional forces were being applied to the brazed stud connections each time the connection was disassembled and reassembled.",
    "cause_code": "B",
    "category": "Design/Manufacturing/Installation",
    "theme": "Transformer bus connection design susceptible to maintenance-induced degradation",
    "provisional": false
  },
