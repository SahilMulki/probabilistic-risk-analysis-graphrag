  "cause": {
    "proximate_text": "multiple degraded connections were observed. These deteriorations resulted from water intrusion through a degraded seal, leading to corrosion. The degraded seal allowed moisture to enter the bus duct, accelerating the corrosion process and adversely affecting the integrity of the electrical connections. The bus duct heater, which is designed to minimize condensation in the bus assembly, was found to be non-functional.",
    "cause_code": "E",
    "category": "Management/QA Deficiency",
    "theme": "degraded seal + non-functional heater allowed moisture ingress/corrosion of bus duct connections",
    "provisional": false
  },
