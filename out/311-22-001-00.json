  "cause": {
    "proximate_text": "The inaccurate indications from the SG pressure sensors were caused by localized freezing of water-filled instrument tubing located directly below the outer penetration area intake dampers. Ambient temperatures were less than 10 degrees Fahrenheit with winds averaging up to 45 miles per hour. Plenum dampers near instrument tubing for 22 and 24 SG steam pressure sensors were open. An ongoing root cause analysis preliminarily identified incomplete implementation of corrective actions from a similar cold weather event in 2003.",
    "cause_code": "E",
    "category": "Management/QA Deficiency",
    "theme": "incomplete implementation of prior cold-weather corrective actions leading to freezing of instrument tubing",
    "provisional": false
  },
