  "cause": {
    "proximate_text": "The root cause for this event was determined to be the MFRV diaphragm provided by the vendor did not meet the vendor's specifications for the valve. TVA determined the diaphragm was made of Ethylene Propylene Rubber (EPR)-70 instead of EPDM or Nitrile. The vendor only provides torque specifications for EPDM or Nitrile, not EPR-70. The performance characteristics of EPR diaphragms are unknown, especially relative to their influence on the required clamping forces.",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "vendor-supplied component did not conform to specification",
    "provisional": true
  },
