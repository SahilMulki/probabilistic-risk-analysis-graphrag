  "block_13": [],
  "cause": {
    "proximate_text": "The root cause was the transient highly reactive, i.e., VAR, loading condition following the turbine trip that was outside the reverse power relay's ability to respond. The large transient reactive load was a result of the aggregate effects of exciter, switchyard, and grid changes that have occurred over time, including series reactor installations in the switchyard, a switchyard line out of service for maintenance, a Palo Verde unit in a refueling outage, and light seasonal loading.",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "Reverse power relay desensitized by transient reactive (VAR) loading, precluding fast bus transfer",
    "provisional": true
  },
