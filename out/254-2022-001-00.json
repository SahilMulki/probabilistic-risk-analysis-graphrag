  "cause": {
    "proximate_text": "The cause of the event was attributed to two equipment malfunctions: a failed level switch in the Unit 1 HPCI Gland Seal Condenser Hotwell, and a failed thermal overload for the Unit 1 HPCI Gland Exhauster motor. The high-level limit switch in the Gland Seal Condenser (GSC) Hotwell suffered age-related degradation which resulted in a failure of the Unit 1 HPCI GSC Condensate pump to actuate on high level.",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "Age-related instrument degradation leading to overheated exhauster motor",
    "provisional": true
  },
