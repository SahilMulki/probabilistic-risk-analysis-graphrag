  "cause": {
    "proximate_text": "The cause of the scram was an improperly tuned emergency level control valve (LCV) for a MSDT. Tuning was performed by a utility technician based on knowledge of the component and their understanding of plant response without adequate work instructions. The controller's setpoints were configured to provide a slower response than was appropriate for responding to a FWH level transient.",
    "cause_code": "A",
    "category": "Personnel Error",
    "theme": "Improper valve tuning without adequate work instructions",
    "provisional": false
  },
