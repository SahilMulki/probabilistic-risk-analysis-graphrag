  "cause": {
    "proximate_text": "Troubleshooting determined that the 2A Core Spray Room Cooler Fan failed due to mechanical binding within its motor. A motor bearing inner race looseness issue caused the bearing to spin on the motor shaft after the motor began producing heat, and the resulting increase in motor current caused overcurrent trips on the motor's thermal overloads. This motor bearing issue persisted because it was not detectable from monitoring vibration data.",
    "cause_code": "X",
    "category": "Other",
    "theme": "undetectable bearing degradation causing motor binding and overcurrent trips",
    "provisional": false
  },
