  "cause": {
    "proximate_text": "a bellows failure, within 2NRV163, that resulted in a failure of the 0.5 inch welded telltale line; preliminary analysis determined that the Pressurizer Spray Valve design includes a bellows telltale line that is susceptible to Stress Corrosion Cracking, which resulted in the telltale line failing when it was subjected to RCS pressure following leakage past the valve internal bellows",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "design-susceptibility (stress corrosion cracking) leading to component failure",
    "provisional": true
  },
