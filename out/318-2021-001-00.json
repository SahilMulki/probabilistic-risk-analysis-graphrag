  "block_13": [],
  "cause": {
    "proximate_text": "The apparent cause of the leak in the pressurizer heater sleeve G1 penetration was determined to be due to radial-axial PWSCC. The PWSCC propagated through the Alloy 82 J-Groove weld material, used to connect the pressurizer heater sleeve to the Alloy 82 weld pad on the pressurizer. Contributors to the apparent cause include a breach of the autogenous seal weld at the inside of the pressurizer lower head which allowed primary water to enter the annulus between the outer sleeve and the pressurizer base shell material and also, weld imperfections existed in the J-Groove weld.",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "primary water stress corrosion cracking of Alloy 82 weld material",
    "provisional": true
  },
