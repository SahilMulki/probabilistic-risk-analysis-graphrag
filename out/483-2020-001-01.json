  "cause": {
    "proximate_text": "this LER's investigation attributes the event to a lack of guidance for equipment designed to require rigorous tensioning, sheave alignment, and belt inspection; the belt tensioning, sheave alignment, and drive alignment were not considered adequate absent a procedure requiring explicit guidance for turning, jacking, and belt replacement work performed by unqualified personnel; unclear procedures for belt replacement adopted by maintenance personnel contributed to inadequate tensioning of the belts",
    "cause_code": "TBD",
    "category": "provisional",
    "theme": "inadequate belt-replacement procedure/guidance leading to improper tensioning and premature belt failure",
    "provisional": true
  },
