# Copy this file to .env and fill in the blanks. .env is git-ignored.
#
# Demo mode ($0, no backend) needs NONE of these. Rebuilding the graph from the
# committed records (docker compose up -d + load_graph) needs only the NEO4J_* vars.

# Anthropic API key — required for Live-mode queries (the router + answerer).
ANTHROPIC_API_KEY=

# NRC ADAMS "APS" subscription key — only needed to RE-FETCH source LER text
# (python -m pragraph.fetch_ler). Not needed to run the app or load the graph.
ADAMS_APS_KEY=

# Neo4j connection — matches docker-compose.yml. Community uses the built-in `neo4j`
# user; the password must be at least 8 characters.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
